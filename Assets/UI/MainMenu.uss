.root { width: 100%; height: 100%; background-color: rgba(0,0,0,0); } .overlay { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.55); } .title { font-size: 72px; color: rgb(255,218,77); -unity-font-style: bold; -unity-text-align: upper-center; margin-top: 80px; } .subtitle { font-size: 24px; color: rgb(210,210,210); -unity-text-align: upper-center; margin-top: 8px; } .btn-container { position: absolute; left: 35%; top: 45%; width: 30%; } .menu-btn { height: 60px; margin-bottom: 16px; background-color: rgba(30,20,10,0.85); border-color: rgba(200,150,50,0.6); border-width: 1px; border-radius: 4px; font-size: 28px; color: rgb(255,255,255); -unity-font-style: bold; -unity-text-align: middle-center; } .menu-btn:hover { background-color: rgba(153,102,26,1); border-color: rgb(255,200,80); } .menu-btn:active { background-color: rgba(200,130,30,1); } .version { position: absolute; right: 16px; bottom: 10px; font-size: 14px; color: rgba(150,150,150,0.7); } .options-panel { position: absolute; left: 20%; top: 10%; width: 60%; height: 80%; background-color: rgba(13,8,5,0.93); border-color: rgba(200,150,50,0.5); border-width: 1px; border-radius: 8px; } .options-title { font-size: 42px; color: rgb(255,218,77); -unity-font-style: bold; -unity-text-align: upper-center; margin-top: 20px; } .options-label { font-size: 20px; color: rgb(200,200,200); margin-left: 30px; margin-top: 16px; } .options-slider { margin-left: 30px; margin-right: 30px; } .back-btn { height: 50px; margin-left: 30%; margin-right: 30%; margin-top: 20px; background-color: rgba(30,20,10,0.85); border-color: rgba(200,150,50,0.6); border-width: 1px; border-radius: 4px; font-size: 24px; color: white; -unity-font-style: bold; -unity-text-align: middle-center; } .back-btn:hover { background-color: rgba(153,102,26,1); }